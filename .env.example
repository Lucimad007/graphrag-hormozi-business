# Copy to .env and fill in values you actually use. Never commit .env.

APP_NAME=graphrag-agent
LOG_LEVEL=INFO

# LLM (OpenAI-compatible). OpenCode Go DeepSeek V4.1 Flash by default.
# Copy your OpenCode Go key into LLM_API_KEY (never commit .env).
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash

# Local BGE-M3 embeddings (FlagEmbedding). First run downloads BAAI/bge-m3.
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# Ingest: larger chunks + parallel DeepSeek calls
INGEST_MAX_CHARS=2500
INGEST_OVERLAP_CHARS=200
INGEST_EXTRACT_CONCURRENCY=8
# OCR image-only PDFs when pypdf/pymupdf find no text (RapidOCR).
INGEST_PDF_OCR=true

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=business_chunks

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local Docker default; change before any shared deployment.
NEO4J_PASSWORD=changeme
