# Copy to .env and fill in values you actually use. Never commit .env.

APP_NAME=graphrag-agent
LOG_LEVEL=INFO

# LLM (OpenAI-compatible). Leave LLM_API_KEY empty until you need extraction/query.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=business_chunks

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
