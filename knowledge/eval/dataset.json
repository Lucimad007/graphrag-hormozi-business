{
  "version": "1.0.0",
  "description": "Deterministic retrieval eval over synthetic business notes. Not a copyrighted corpus.",
  "cases": [
    {
      "id": "leads-low-close-rate",
      "query": "What is probably causing a business with lots of leads but a low close rate?",
      "expect_documents": ["low-close-rate.md"],
