      "expect_relationship_types": ["MEASURED_BY"]
    },
    {
      "id": "inspect-offer",
      "query": "Should I buy more traffic or inspect the offer and sales process?",
      "expect_documents": ["low-close-rate.md"],
      "expect_entity_ids": ["metric:close-rate"],
      "expect_relationship_types": ["IMPROVES"]
    },
    {
      "id": "unclear-offer",
      "query": "Why would an unclear offer stall closes?",
      "expect_documents": ["offer-clarity.md"],
      "expect_entity_ids": ["offer:unclear-offer", "problem:confusion-about-what-is-being-bought"],
      "expect_relationship_types": ["SOLVES"]
    }
  ]
}
